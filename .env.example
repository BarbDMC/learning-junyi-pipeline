# Copy to .env: cp .env.example .env

# PostgreSQL
POSTGRES_DB=warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=junyi-raw

# Warehouse the DAG uses when triggered without choosing a target: local or supabase
WAREHOUSE_TARGET=local
# Max Log_Problem rows for the local warehouse; empty loads all 16M (~6 GB)
LOCAL_LOG_PROBLEM_ROW_LIMIT=

# Supabase (cloud warehouse): Project > Connect > Session pooler.
# The direct db.<ref>.supabase.co host is IPv6-only, which Docker usually can't reach.
# Example host: aws-0-<region>.pooler.supabase.com; user: postgres.<project-ref>
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=
SUPABASE_PASSWORD=
SUPABASE_SSLMODE=require
# 500000 keeps the warehouse around 225 MB, under the free plan's 500 MB
SUPABASE_LOG_PROBLEM_ROW_LIMIT=500000

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_PORT=8080
# Regenerate with: python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=EDbZZ6Ygj4N2AJjWJkgqiZsL-5O0pLX1SfEpIHts55Y=
