# Copy to .streamlit/secrets.toml (git-ignored).
# Each [connections.<name>] is a data source. With more than one, the sidebar lets you pick;
# with none (no secrets file), the app reads the local Docker warehouse.

[connections.local]
dialect = "postgresql"
host = "localhost"
port = 5433
database = "warehouse"
username = "postgres"
password = "postgres"

# Supabase: use the Session pooler details (Project > Connect > Session pooler).
# For a public app, use a read-only role instead of postgres (see README).
# [connections.supabase]
# dialect = "postgresql"
# host = "supabase-host.pooler.supabase.com"
# port = 5432
# database = "postgres"
# username = "user.<project-ref>"
# password = "<password>"
# query = { sslmode = "require" }
